; Engine configuration file.
config_version=5

[application]

config/name="QATU: El Reino Compilado"
config/description="Metroidvania educativo de Desarrollo de Software 4"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.03, 0.05, 1)
boot_splash/show_image=false

[autoload]

Events="*res://autoload/events.gd"
Settings="*res://autoload/settings.gd"
ContentDB="*res://autoload/content_db.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
AudioManager="*res://autoload/audio_manager.gd"
RoomRouter="*res://autoload/room_router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="cuerpo_jugador"
2d_physics/layer_3="cuerpo_enemigo"
2d_physics/layer_4="hurtbox_jugador"
2d_physics/layer_5="golpeables"
2d_physics/layer_6="ataque_jugador"
2d_physics/layer_7="dano_jugador"
2d_physics/layer_8="interactuables"

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=0.0

[rendering]

viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.05, 1)
anti_aliasing/quality/msaa_2d=2
